local GREETING_URL =
    "https://raw.githubusercontent.com/zxcswastik-cyber/XoseCity/main/XOSE_Greeting_Character.png"

local IMAGE_PATH = "XOSE/assets/greeting.png"

local function ensureGreetingImage()
    if type(isfile) == "function" and isfile(IMAGE_PATH) then
        return true
    end

    if type(makefolder) == "function" then
        if not isfolder("XOSE") then
            makefolder("XOSE")
        end

        if not isfolder("XOSE/assets") then
            makefolder("XOSE/assets")
        end
    end

    local ok, data = pcall(function()
        return game:HttpGet(GREETING_URL)
    end)

    if not ok or type(data) ~= "string" or #data < 10000 then
        return false
    end

    return pcall(writefile, IMAGE_PATH, data)
end

local function getGreetingImage()
    if not ensureGreetingImage() then
        return nil
    end

    if type(getcustomasset) == "function" then
        return getcustomasset(IMAGE_PATH)
    elseif type(getsynasset) == "function" then
        return getsynasset(IMAGE_PATH)
    end

    return nil
end
